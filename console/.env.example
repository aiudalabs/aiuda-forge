# URL del control-plane de vibeforge-v2 (kernel API). Default: http://localhost:8080
# El cliente lee esto en el servidor (NEXT_PUBLIC_ lo expone al browser para WS/fetch directo).
NEXT_PUBLIC_VIBEFORGE_API_URL=http://localhost:8080

# Fuerza el modo mock aunque la API responda (útil para demo / desarrollo de UI).
# Valores: "1" para forzar mock, "0"/vacío para auto-detectar.
NEXT_PUBLIC_FORCE_MOCK=
