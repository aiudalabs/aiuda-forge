// session_persists — UNIVERSAL invariant (§2B), one checker per stack (stack DATA).
//
// Truth every app must hold: a logged-in user stays logged in across an app restart
// (the live-session bug from the E2E session was "the app always asks for login").
// Two parts, both required:
//   1. CONFIG: the app must persist the session (Firebase Auth LOCAL persistence).
//      In-memory / NONE persistence = login is lost on restart = the bug.
//   2. BEHAVIOR: the refresh token the backend issued must still mint a fresh ID token
//      after a simulated "relaunch" (a token round-trip against the Auth emulator).
//
// The app declares its persistence choice in app_config.json at the repo root, mirroring
// the Flutter `Persistence` setting the app ships with. Config lives in the repo, so the
// checker reads the real shipped value rather than assuming it.
import { readFileSync } from 'node:fs';
import { clientApp, signUpFreshUser, HOST, AUTH_PORT, PROJECT } from '../lib.mjs';

let cfg;
try { cfg = JSON.parse(readFileSync('app_config.json', 'utf8')); }
catch { cfg = { authPersistence: 'LOCAL' }; }  // default assumption if unspecified

if (cfg.authPersistence !== 'LOCAL') {
  console.log(`  FAIL session_persists VIOLATED: app persistence is '${cfg.authPersistence}' — login is not retained across restart`);
  process.exit(1);
}

const { auth } = clientApp('session');
const user = await signUpFreshUser(auth, 'session');

// Simulate a relaunch: exchange the persisted refresh token for a new ID token.
const res = await fetch(`http://${HOST}:${AUTH_PORT}/securetoken.googleapis.com/v1/token?key=fake-api-key`, {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ grant_type: 'refresh_token', refresh_token: user.refreshToken }),
});
const j = await res.json().catch(() => ({}));
if (res.ok && j.id_token) {
  console.log('  OK   session_persists holds (refresh token honored after restart)');
  process.exit(0);
}
console.log(`  FAIL session_persists VIOLATED: refresh token not honored — ${JSON.stringify(j)}`);
process.exit(1);
