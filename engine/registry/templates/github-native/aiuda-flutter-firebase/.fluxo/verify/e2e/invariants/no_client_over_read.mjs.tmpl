// no_client_over_read — UNIVERSAL invariant (§2B), one checker per stack (stack DATA).
//
// Truth every app must hold: an authenticated client can read ONLY what it is entitled
// to. Server/admin access bypasses rules, so this MUST be checked from a real client.
// Bug shape it catches: an over-permissive security rule (`allow read: if true`) that
// exposes private/admin data to any signed-in user — the mirror image of bug #3.
//
// Method: sign in a normal user and attempt to read a collection that must be private
// (admin_config). Denied = invariant holds. Any success (even an empty snapshot) = the
// rule allowed the read = VIOLATION.
import { doc, getDoc } from 'firebase/firestore';
import { clientApp, signUpFreshUser } from '../lib.mjs';

const { auth, db } = clientApp('overread');
await signUpFreshUser(auth, 'overread');

try {
  const snap = await getDoc(doc(db, 'admin_config', 'secrets'));
  console.log(`  FAIL no_client_over_read VIOLATED: client read admin_config (exists=${snap.exists()})`);
  process.exit(1);
} catch (e) {
  console.log(`  OK   no_client_over_read holds (${e.code || e.message})`);
  process.exit(0);
}
