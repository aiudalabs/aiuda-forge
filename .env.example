# ── aiuda-forge — environment template ──────────────────────────────────────
# Copy to .env and fill in values before running `docker compose up --build`.
# NEVER commit .env to git.

# ── Admin seed (first user, created on first boot) ───────────────────────────
VIBEFORGE_ADMIN_EMAIL=admin@example.com
VIBEFORGE_ADMIN_PASSWORD=change-me-before-deploy

# ── Service token (required for auth to be active) ───────────────────────────
# Generate with: openssl rand -hex 32
VIBEFORGE_API_TOKEN=

# ── AI provider ──────────────────────────────────────────────────────────────
# Mode: oauth_token (Claude subscription/Max/Pro) | api_key (pay-per-token)
VIBEFORGE_AGENT_AUTH=oauth_token

# Claude subscription token (mode = oauth_token):
CLAUDE_CODE_OAUTH_TOKEN=

# Anthropic API key (mode = api_key):
ANTHROPIC_API_KEY=

# ── Brain (in-app assistant) ─────────────────────────────────────────────────
# The Brain's LLM. Opus for master-level orchestration reasoning. The Brain
# activates only when ANTHROPIC_API_KEY is set (it uses the Messages API).
BRAIN_MODEL=claude-opus-4-8

# ── GitHub ────────────────────────────────────────────────────────────────────
# GitHub org or username for repo creation (e.g. "nmlemus" or "aiudalabs").
VIBEFORGE_GH_ORG=

# GitHub personal access token (gh CLI uses GH_TOKEN if set).
GH_TOKEN=

# ── Engine & sandbox ─────────────────────────────────────────────────────────
VIBEFORGE_ENGINE=claude
VIBEFORGE_SANDBOX=docker

# ── CORS (must match the console's public URL) ────────────────────────────────
VIBEFORGE_CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_VIBEFORGE_API_URL=http://localhost:8080

# ── DooD workdir (IMPORTANT — read docker-compose.yml header) ────────────────
# This path is mounted at the SAME absolute path on host and inside the control
# container. Agent containers spawned at runtime receive this path via -v flags,
# which the host Docker daemon resolves.
#
# macOS Docker Desktop auto-shares /Users, /tmp, /private.
# Use a path under /Users for persistence; /tmp is cleared on reboot.
FORGE_WORKDIR=/tmp/vibeforge-runs

# ── Producción (deploy/docker-compose.prod.yml) ──────────────────────────────
# Dominio público único (Caddy emite el TLS para este dominio). Ver DEPLOY.md.
FLUXO_DOMAIN=fluxo.aiudalabs.com
# Operabilidad (buenos defaults; 0 en RETENTION apaga la limpieza).
VIBEFORGE_RETENTION_DAYS=30
VIBEFORGE_GH_TIMEOUT_SEC=90
# Secret del webhook de la GitHub App (solo si activás webhooks — ver DEPLOY.md §6).
VIBEFORGE_GITHUB_WEBHOOK_SECRET=
