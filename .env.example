# ── aiuda-forge — environment template ──────────────────────────────────────
# Copy to .env and fill in values before running `docker compose up --build`.
# NEVER commit .env to git.

# ── Admin seed (first user, created on first boot) ───────────────────────────
VIBEFORGE_ADMIN_EMAIL=admin@example.com
VIBEFORGE_ADMIN_PASSWORD=change-me-before-deploy

# ── Service token (required for auth to be active) ───────────────────────────
# Generate with: openssl rand -hex 32
VIBEFORGE_API_TOKEN=

# ── AI provider ──────────────────────────────────────────────────────────────
# Mode: oauth_token (Claude subscription/Max/Pro) | api_key (pay-per-token)
VIBEFORGE_AGENT_AUTH=oauth_token

# Claude subscription token (mode = oauth_token):
CLAUDE_CODE_OAUTH_TOKEN=

# Anthropic API key (mode = api_key):
ANTHROPIC_API_KEY=

# ── Brain (in-app assistant) ─────────────────────────────────────────────────
# The Brain's LLM. Opus for master-level orchestration reasoning. The Brain
# activates only when ANTHROPIC_API_KEY is set (it uses the Messages API).
BRAIN_MODEL=claude-opus-4-8

# ── GitHub ────────────────────────────────────────────────────────────────────
# GitHub org or username for repo creation (e.g. "nmlemus" or "aiudalabs").
VIBEFORGE_GH_ORG=

# GitHub personal access token (gh CLI uses GH_TOKEN if set).
GH_TOKEN=

# PR mode for the `pr` step. github = open+merge real GitHub PRs (REQUIRED in prod: the design
# docs_pr runs in the control and must land docs/ on main before sprints dispatch). local =
# offline dev/tests only — pushing a branch without a PR against a real GitHub origin strands docs.
PR_MODE=github

# ── Engine & sandbox ─────────────────────────────────────────────────────────
VIBEFORGE_ENGINE=claude
VIBEFORGE_SANDBOX=docker

# Sandbox build image for the `release` step (#23): npm ci / npm run build /
# firebase deploy run INSIDE this image (never on the host). Build it before the
# first `docker compose up` with:  ./engine/scripts/build-sandbox-images.sh
# (image = node LTS + npm + git + python3 + firebase-tools). Default tag below.
VIBEFORGE_AGENT_IMAGE=vibeforge-agent:local

# ── Identity URLs — DO NOT set here (incident 2026-07-09) ─────────────────────
# VIBEFORGE_PUBLIC_URL / VIBEFORGE_CONSOLE_URL / VIBEFORGE_CORS_ORIGIN /
# NEXT_PUBLIC_VIBEFORGE_API_URL are NO LONGER read from .env. They come from the
# compose layer so a bare `docker compose up` can't silently pick dev defaults:
#   • DEV  → docker-compose.override.yml (auto-loaded) sets them to localhost +
#            VIBEFORGE_ALLOW_LOCAL_URL=1. Nothing to do here.
#   • PROD → deploy/docker-compose.prod.yml derives them from FLUXO_DOMAIN. Set
#            FLUXO_DOMAIN and COMPOSE_FILE below.
# The control REFUSES to boot with users on an empty/localhost VIBEFORGE_PUBLIC_URL
# unless VIBEFORGE_ALLOW_LOCAL_URL=1 (the dev override sets it).

# ── DooD workdir (IMPORTANT — read docker-compose.yml header) ────────────────
# This path is mounted at the SAME absolute path on host and inside the control
# container. Agent containers spawned at runtime receive this path via -v flags,
# which the host Docker daemon resolves.
#
# macOS Docker Desktop auto-shares /Users, /tmp, /private.
# Use a path under /Users for persistence; /tmp is cleared on reboot.
FORGE_WORKDIR=/tmp/vibeforge-runs

# ── Previews (release step #23) ──────────────────────────────────────────────
# REQUIRED IN PROD. HMAC key that signs preview-capability tokens. If left empty a
# random per-process key is used → every preview link dies on each control restart.
# Generate: openssl rand -hex 32
VIBEFORGE_PREVIEW_SECRET=
# Optional release-build tuning (defaults shown). Usually leave as-is.
# VIBEFORGE_RELEASE_BUILD_TIMEOUT_MIN=10
# VIBEFORGE_RELEASE_MAX_MB=200
# VIBEFORGE_RELEASE_KEEP=5

# ── Ceremonias / digest (PR #18/#19/#26) ─────────────────────────────────────
# Daily standup digest cron. Evaluated in UTC — the container timezone is IGNORED.
# Default 0 13 * * * = 13:00 UTC (08:00 Panamá). Pick the UTC time you want it to fire.
# The Telegram BOT TOKEN and each project's DIGEST CHANNEL are configured IN-APP
# (Settings → Telegram token; per-project digest channel), NOT here.
VIBEFORGE_DIGEST_CRON=0 13 * * *
# JIT grooming pre-dispatch (#18). "0" disables; anything else (default) enables.
VIBEFORGE_CONDUCTOR_GROOM=1
# Design-agent wall-clock (#14) and idle watchdog (#26), in minutes. Bump the
# wall-clock for very large designs (the backlog phase can be slow).
VIBEFORGE_AGENT_TIMEOUT_MIN=20
VIBEFORGE_AGENT_IDLE_TIMEOUT_MIN=8

# ── Producción (deploy/docker-compose.prod.yml) ──────────────────────────────
# OBLIGATORIO EN PROD — hace que TODO comando `docker compose …` incluya el overlay
# de prod SIN acordarse del `-f` (la causa raíz del incidente 2026-07-09). Al estar
# seteada, compose NO auto-carga docker-compose.override.yml (el de dev). DEJALA
# COMENTADA en desarrollo (así el override de dev sí se carga solo).
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.prod.yml
#
# Dominio público único (Caddy emite el TLS para este dominio). Ver DEPLOY.md.
# Requerido en prod: si falta, `docker compose` falla en `config` (no arranca con
# https:///forge-api). En dev no se usa.
FLUXO_DOMAIN=fluxo.aiudalabs.com
# Operabilidad (buenos defaults; 0 en RETENTION apaga la limpieza).
VIBEFORGE_RETENTION_DAYS=30
VIBEFORGE_GH_TIMEOUT_SEC=90
# Secret del webhook de la GitHub App (solo si activás webhooks — ver DEPLOY.md §6).
VIBEFORGE_GITHUB_WEBHOOK_SECRET=
